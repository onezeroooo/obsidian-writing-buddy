{
  "name": "recanta-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host-independent evidence and memory infrastructure",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node/index.d.ts",
      "default": "./dist/src/node/index.js"
    },
    "./http": {
      "types": "./dist/src/http/index.d.ts",
      "default": "./dist/src/http/index.js"
    },
    "./sqljs": {
      "types": "./dist/src/drivers/sqljs.d.ts",
      "default": "./dist/src/drivers/sqljs.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "demo": "node examples/event-store.ts",
    "demo:memory": "node examples/memory-loop.ts",
    "inspector": "node examples/inspector.ts",
    "dev-check": "node scripts/dev-check.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "check:package": "node scripts/package-check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "sql.js": "1.14.2",
    "typescript": "7.0.2"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "sideEffects": false,
  "license": "UNLICENSED"
}
