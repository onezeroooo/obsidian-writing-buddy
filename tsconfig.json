{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"recanta-dev": ["./vendor/recanta/dist/src/index.d.ts"],
			"recanta-dev/sqljs": ["./vendor/recanta/dist/src/drivers/sqljs.d.ts"],
			"obsidian": ["./vendor/types/obsidian.d.ts"],
			"@codemirror/state": ["./vendor/types/state.d.ts"],
			"@codemirror/view": ["./vendor/types/view.d.ts"],
			"style-mod": ["./vendor/types/style-mod.d.ts"],
			"moment": ["./vendor/types/moment.d.ts"]
		},
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"allowJs": false,
		"noImplicitAny": true,
		"strict": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"importHelpers": false,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2022"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
